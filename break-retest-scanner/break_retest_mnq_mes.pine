//@version=6
indicator("Break & Retest · MNQ/MES · Paper Signals", overlay=true)

// Apply to a 5-minute chart. The 1-hour filter uses only completed hourly candles.
int pivotLen = input.int(2, "Pivot strength", minval=1, maxval=8)
int lookback = input.int(80, "Level lookback (5m candles)", minval=20, maxval=300)
int retestBars = input.int(12, "Max bars to wait for retest", minval=1, maxval=50)
float toleranceTicks = input.float(2, "Retest tolerance (ticks)", minval=0, step=1)
int emaLen = input.int(50, "1h trend EMA", minval=10, maxval=200)
float targetR = input.float(2.0, "Target (R)", minval=0.5, maxval=5, step=0.5)
float smallBodyAtr = input.float(0.30, "Small retest candle body / ATR", minval=0.1, maxval=1, step=0.05)
float commissionSide = input.float(0.50, "Commission per side / contract (USD)", minval=0, step=0.05)
int contracts = input.int(1, "Micro-contracts", minval=1, maxval=100)
string inputToken = input.string("SET_RENDER_WEBHOOK_TOKEN", "Webhook token")

bool isFive = timeframe.isminutes and timeframe.multiplier == 5
float hClose = request.security(syminfo.tickerid, "60", close[1], lookahead=barmerge.lookahead_on)
float hEma = request.security(syminfo.tickerid, "60", ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_on)
float hEmaPrev = request.security(syminfo.tickerid, "60", ta.ema(close, emaLen)[2], lookahead=barmerge.lookahead_on)
bool trendUp = hClose > hEma and hEma > hEmaPrev
bool trendDown = hClose < hEma and hEma < hEmaPrev
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float priorPivot = ta.valuewhen(not na(ph), ph, 1)
float level = not na(ph) and not na(priorPivot) and math.abs(ph - priorPivot) <= ta.atr(14)[pivotLen] * 0.25 ? (ph + priorPivot) / 2 : na
float resistance = ta.valuewhen(not na(level), level, 0)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float priorLowPivot = ta.valuewhen(not na(pl), pl, 1)
float lowLevel = not na(pl) and not na(priorLowPivot) and math.abs(pl - priorLowPivot) <= ta.atr(14)[pivotLen] * 0.25 ? (pl + priorLowPivot) / 2 : na
float support = ta.valuewhen(not na(lowLevel), lowLevel, 0)
float tick = syminfo.mintick
float tol = toleranceTicks * tick
float atr = ta.atr(14)

var float waitingLevel = na
var string waitingSide = ""
var int breakoutBar = na
var int barsWaiting = 0
var bool tracking = false
var int entryBar = na
var string signalId = ""
var string tradeSide = ""
var float entryPrice = na
var float stopPrice = na
var float initialRiskPoints = na
var float targetPrice = na
var int followCount = 0

bool breakout = isFive and not tracking and na(waitingLevel) and trendUp and not na(resistance) and close[1] <= resistance and close > resistance
if breakout
    waitingLevel := resistance
    waitingSide := "LONG"
    breakoutBar := bar_index
    barsWaiting := 0
bool breakdown = isFive and not tracking and na(waitingLevel) and trendDown and not na(support) and close[1] >= support and close < support
if breakdown
    waitingLevel := support
    waitingSide := "SHORT"
    breakoutBar := bar_index
    barsWaiting := 0

if not na(waitingLevel)
    barsWaiting += 1
    if barsWaiting > retestBars or close < waitingLevel - tol
        waitingLevel := na
    else if bar_index > breakoutBar and low <= waitingLevel + tol and high >= waitingLevel - tol and ((waitingSide == "LONG" and trendUp) or (waitingSide == "SHORT" and trendDown)) and barstate.isconfirmed
        float body = math.abs(close - open)
        float prevBodyLow = math.min(open[1], close[1])
        float bodyLow = math.min(open, close)
        float prevBodyHigh = math.max(open[1], close[1])
        float bodyHigh = math.max(open, close)
        float base = waitingSide == "LONG" ? (body <= smallBodyAtr * atr ? prevBodyLow : bodyLow) : (body <= smallBodyAtr * atr ? prevBodyHigh : bodyHigh)
        entryPrice := waitingLevel
        stopPrice := waitingSide == "LONG" ? math.floor((base - tick) / tick) * tick : math.ceil((base + tick) / tick) * tick
        if (waitingSide == "LONG" and stopPrice < entryPrice) or (waitingSide == "SHORT" and stopPrice > entryPrice)
            initialRiskPoints := math.abs(entryPrice - stopPrice)
            targetPrice := entryPrice + (waitingSide == "LONG" ? 1 : -1) * initialRiskPoints * targetR
            signalId := syminfo.tickerid + "|" + str.tostring(time)
            tradeSide := waitingSide
            tracking := true
            entryBar := bar_index
            followCount := 0
            string payload = '{"token":"' + inputToken + '","event":"entry","signalId":"' + signalId + '","symbol":"' + syminfo.ticker + '","side":"' + tradeSide + '","trend":"' + (tradeSide == "LONG" ? "UP" : "DOWN") + '","level":' + str.tostring(waitingLevel) + ',"entry":' + str.tostring(entryPrice) + ',"stop":' + str.tostring(stopPrice) + ',"target":' + str.tostring(targetPrice) + ',"contracts":' + str.tostring(contracts) + ',"time":' + str.tostring(time) + '}'
            alert(payload, alert.freq_once_per_bar_close)
        waitingLevel := na

// Track all bars until exit; the dashboard displays only the first five follow-up candle arrows.
if tracking and barstate.isconfirmed and bar_index > entryBar
    followCount += 1
    bool stopHit = tradeSide == "LONG" ? low <= stopPrice : high >= stopPrice
    bool targetHit = tradeSide == "LONG" ? high >= targetPrice : low <= targetPrice
    string dir = close >= open ? "up" : "down"
    string exitState = stopHit ? "stop" : targetHit ? "target" : "none"
    if not stopHit and not targetHit
        float pointValue = syminfo.ticker == "MNQ" ? 2.0 : 5.0
        float feePoints = commissionSide * 2 * contracts / (pointValue * contracts)
        if tradeSide == "LONG" and high >= entryPrice + initialRiskPoints
            stopPrice := math.max(stopPrice, math.ceil((entryPrice + feePoints) / tick) * tick)
        if tradeSide == "SHORT" and low <= entryPrice - initialRiskPoints
            stopPrice := math.min(stopPrice, math.floor((entryPrice - feePoints) / tick) * tick)
        float swingLow = ta.valuewhen(not na(pl), pl, 0)
        float swingHigh = ta.valuewhen(not na(ph), ph, 0)
        if tradeSide == "LONG" and not na(swingLow) and swingLow - tick > stopPrice and swingLow > entryPrice
            stopPrice := math.floor((swingLow - tick) / tick) * tick
        if tradeSide == "SHORT" and not na(swingHigh) and swingHigh + tick < stopPrice and swingHigh < entryPrice
            stopPrice := math.ceil((swingHigh + tick) / tick) * tick
    float exitPrice = stopHit ? stopPrice : targetPrice
    string update = '{"token":"' + inputToken + '","event":"followup","signalId":"' + signalId + '","symbol":"' + syminfo.ticker + '","n":' + str.tostring(math.min(followCount, 5)) + ',"dir":"' + dir + '","stop":' + str.tostring(stopPrice) + ',"exitPrice":' + str.tostring(exitPrice) + ',"exit":"' + exitState + '","time":' + str.tostring(time) + '}'
    alert(update, alert.freq_once_per_bar_close)
    if stopHit or targetHit
        tracking := false

plot(resistance, "Detected resistance", color=color.new(color.aqua, 10), linewidth=2, style=plot.style_linebr)
plot(support, "Detected support", color=color.new(color.orange, 10), linewidth=2, style=plot.style_linebr)
plotshape(breakout, title="Breakout", style=shape.triangleup, color=color.lime, location=location.belowbar, size=size.tiny, text="BRK")
plotshape(tracking and followCount == 0, title="Retest entry", style=shape.labelup, color=color.green, textcolor=color.white, location=location.belowbar, text="LONG")

// Replace with a long random value and set the same WEBHOOK_TOKEN in Render.
